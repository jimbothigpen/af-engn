#version 450

#include "mul_mat_vec_base.glsl"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

const uint k_mult_iq1_bn[5] = uint[5](81, 27, 9, 3, 1);

uint read_u16(uint offset) {
return uint(data_a[offset]) | (uint(data_a[offset + 1]) << 8);
}

void compute_outputs(uint first_row, uint num_rows) {
uint a_offset, b_offset, d_offset;
get_offsets(a_offset, b_offset, d_offset);
const uint nb = p.ncols / 64;
const uint row_bytes = 2 + nb * 13;
const uint tid = gl_LocalInvocationID.x;
const uint i16 = tid % 4;

for (uint j = 0; j < NUM_COLS; ++j) {
for (uint n = 0; n < NUM_ROWS; ++n) {
temp[j][n] = FLOAT_TYPE(0);
}
}

for (uint i = tid / 4; i < nb; i += gl_WorkGroupSize.x / 4) {
for (uint n = 0; n < num_rows; ++n) {
const uint row_offset = (a_offset / nb + first_row + n) * row_bytes;
const uint block_offset = row_offset + 2 + i * 13;
const float d = unpackHalf2x16(read_u16(row_offset)).x;

const uint q0 = uint(data_a[block_offset + 3 * i16 + 0]);
const uint q1 = uint(data_a[block_offset + 3 * i16 + 1]);
const uint q2 = uint(data_a[block_offset + 3 * i16 + 2]);
const uint extra = uint(data_a[block_offset + 12]);

for (uint j = 0; j < NUM_COLS; ++j) {
const uint base = j * p.batch_stride_b + b_offset + i * 64 + 16 * i16;
FLOAT_TYPE acc = FLOAT_TYPE(0);
[[unroll]] for (uint r = 0; r < 15; ++r) {
const uint q = (r < 5) ? q0 : ((r < 10) ? q1 : q2);
const uint v = (q * k_mult_iq1_bn[r % 5]) & 0xFFu;
const uint vs = (v + (v >> 1)) >> 7;
acc = fma(FLOAT_TYPE(data_b[base + r]), FLOAT_TYPE(int(vs) - 1), acc);
}
const uint v15 = (extra * k_mult_iq1_bn[i16]) & 0xFFu;
const uint vs15 = (v15 + (v15 >> 1)) >> 7;
acc = fma(FLOAT_TYPE(data_b[base + 15]), FLOAT_TYPE(int(vs15) - 1), acc);
temp[j][n] = fma(FLOAT_TYPE(d), acc, temp[j][n]);
}
}
}
reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);
if (first_row >= p.stride_d) {
return;
}
compute_outputs(first_row, min(NUM_ROWS, p.stride_d - first_row));
}
