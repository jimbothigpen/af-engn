#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage : require

#include "mul_mat_vec_base.glsl"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

const int kvalues_iq5_k[64] = int[64](
    -126, -114, -103, -92, -83, -74, -65, -57, -50, -43, -36, -30, -24, -18, -12, -6, -1, 5, 11, 17, 23, 29, 36, 43, 51, 59, 68, 77, 87, 97, 109, 121,
    -124, -112, -101, -90, -81, -72, -63, -55, -48, -41, -34, -28, -22, -16, -10, -4,  1, 7, 13, 19, 25, 31, 38, 45, 53, 61, 70, 79, 89, 99, 111, 123
);

void calc_superblock(const uint a_offset, const uint b_offset, const uint ib32, const uint i, const uint num_blocks_per_row, const uint first_row, const uint num_rows) {
    const uint y_idx = i * QUANT_K + 32 * ib32;

    uint ibi = a_offset + first_row * num_blocks_per_row + i;
    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
        const float d = float(data_a[ibi].d);
        const uint ib64 = ib32 / 2;
        const uint sb = 2 * (ib32 % 2);
        const uint sh = uint(data_a[ibi].scales_h[ib64]);
        const uint sl = uint(data_a[ibi].scales_l[2 * ib64 + (ib32 % 2)]);
        const int raw0 = int(sl & 0xf);
        const int raw1 = int(sl >> 4);
        const uint sh0 = (sb == 0) ? ((sh << 4) & 0x30) : ((sh     ) & 0x30);
        const uint sh1 = (sb == 0) ? ((sh << 2) & 0x30) : ((sh >> 2) & 0x30);
        const int scale0 = (raw0 | int(sh0)) - 32;
        const int scale1 = (raw1 | int(sh1)) - 32;
        const float dscale0 = d * float(scale0);
        const float dscale1 = d * float(scale1);
        const uint table0 = (((uint(data_a[ibi].extra) >> (4 * ib64 + sb + 0)) & 1) != 0) ? 32 : 0;
        const uint table1 = (((uint(data_a[ibi].extra) >> (4 * ib64 + sb + 1)) & 1) != 0) ? 32 : 0;
        const uint qs_base = 32 * ib64;
        const uint shift = 2 * ib64;
        const uint sub16_0 = sb + 0;
        const uint sub16_1 = sb + 1;

        FLOAT_TYPE sum0[NUM_COLS];
        FLOAT_TYPE sum1[NUM_COLS];
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            sum0[j] = FLOAT_TYPE(0);
            sum1[j] = FLOAT_TYPE(0);
        }

        [[unroll]] for (uint l = 0; l < 4; ++l) {
            const uint idx0 = 4 * l;
            const uint idx1 = 16 + 4 * l;

            const uint low4_0_0 = (sub16_0 < 2) ? (uint(data_a[ibi].qs[qs_base + idx0 + 0]) & 0xf) : (uint(data_a[ibi].qs[qs_base + idx0 + 0]) >> 4);
            const uint high1_0_0 = (sub16_0 < 2) ? ((uint(data_a[ibi].qh[idx0 + 0]) >> shift) & 1) : (((uint(data_a[ibi].qh[idx0 + 0]) >> shift) & 2) >> 1);
            const uint q0_0 = low4_0_0 | (high1_0_0 << 4);

            const uint low4_0_1 = (sub16_0 < 2) ? (uint(data_a[ibi].qs[qs_base + idx0 + 1]) & 0xf) : (uint(data_a[ibi].qs[qs_base + idx0 + 1]) >> 4);
            const uint high1_0_1 = (sub16_0 < 2) ? ((uint(data_a[ibi].qh[idx0 + 1]) >> shift) & 1) : (((uint(data_a[ibi].qh[idx0 + 1]) >> shift) & 2) >> 1);
            const uint q0_1 = low4_0_1 | (high1_0_1 << 4);

            const uint low4_0_2 = (sub16_0 < 2) ? (uint(data_a[ibi].qs[qs_base + idx0 + 2]) & 0xf) : (uint(data_a[ibi].qs[qs_base + idx0 + 2]) >> 4);
            const uint high1_0_2 = (sub16_0 < 2) ? ((uint(data_a[ibi].qh[idx0 + 2]) >> shift) & 1) : (((uint(data_a[ibi].qh[idx0 + 2]) >> shift) & 2) >> 1);
            const uint q0_2 = low4_0_2 | (high1_0_2 << 4);

            const uint low4_0_3 = (sub16_0 < 2) ? (uint(data_a[ibi].qs[qs_base + idx0 + 3]) & 0xf) : (uint(data_a[ibi].qs[qs_base + idx0 + 3]) >> 4);
            const uint high1_0_3 = (sub16_0 < 2) ? ((uint(data_a[ibi].qh[idx0 + 3]) >> shift) & 1) : (((uint(data_a[ibi].qh[idx0 + 3]) >> shift) & 2) >> 1);
            const uint q0_3 = low4_0_3 | (high1_0_3 << 4);

            const uint low4_1_0 = (sub16_1 < 2) ? (uint(data_a[ibi].qs[qs_base + idx1 + 0]) & 0xf) : (uint(data_a[ibi].qs[qs_base + idx1 + 0]) >> 4);
            const uint high1_1_0 = (sub16_1 < 2) ? ((uint(data_a[ibi].qh[idx1 + 0]) >> shift) & 1) : (((uint(data_a[ibi].qh[idx1 + 0]) >> shift) & 2) >> 1);
            const uint q1_0 = low4_1_0 | (high1_1_0 << 4);

            const uint low4_1_1 = (sub16_1 < 2) ? (uint(data_a[ibi].qs[qs_base + idx1 + 1]) & 0xf) : (uint(data_a[ibi].qs[qs_base + idx1 + 1]) >> 4);
            const uint high1_1_1 = (sub16_1 < 2) ? ((uint(data_a[ibi].qh[idx1 + 1]) >> shift) & 1) : (((uint(data_a[ibi].qh[idx1 + 1]) >> shift) & 2) >> 1);
            const uint q1_1 = low4_1_1 | (high1_1_1 << 4);

            const uint low4_1_2 = (sub16_1 < 2) ? (uint(data_a[ibi].qs[qs_base + idx1 + 2]) & 0xf) : (uint(data_a[ibi].qs[qs_base + idx1 + 2]) >> 4);
            const uint high1_1_2 = (sub16_1 < 2) ? ((uint(data_a[ibi].qh[idx1 + 2]) >> shift) & 1) : (((uint(data_a[ibi].qh[idx1 + 2]) >> shift) & 2) >> 1);
            const uint q1_2 = low4_1_2 | (high1_1_2 << 4);

            const uint low4_1_3 = (sub16_1 < 2) ? (uint(data_a[ibi].qs[qs_base + idx1 + 3]) & 0xf) : (uint(data_a[ibi].qs[qs_base + idx1 + 3]) >> 4);
            const uint high1_1_3 = (sub16_1 < 2) ? ((uint(data_a[ibi].qh[idx1 + 3]) >> shift) & 1) : (((uint(data_a[ibi].qh[idx1 + 3]) >> shift) & 2) >> 1);
            const uint q1_3 = low4_1_3 | (high1_1_3 << 4);

            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                const vec4 b0 = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + y_idx) / 4 + l]);
                const vec4 b1 = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + y_idx) / 4 + 4 + l]);

                sum0[j] = fma(FLOAT_TYPE(b0.x), FLOAT_TYPE(kvalues_iq5_k[table0 + q0_0]),
                          fma(FLOAT_TYPE(b0.y), FLOAT_TYPE(kvalues_iq5_k[table0 + q0_1]),
                          fma(FLOAT_TYPE(b0.z), FLOAT_TYPE(kvalues_iq5_k[table0 + q0_2]),
                          fma(FLOAT_TYPE(b0.w), FLOAT_TYPE(kvalues_iq5_k[table0 + q0_3]),
                          sum0[j]))));
                sum1[j] = fma(FLOAT_TYPE(b1.x), FLOAT_TYPE(kvalues_iq5_k[table1 + q1_0]),
                          fma(FLOAT_TYPE(b1.y), FLOAT_TYPE(kvalues_iq5_k[table1 + q1_1]),
                          fma(FLOAT_TYPE(b1.z), FLOAT_TYPE(kvalues_iq5_k[table1 + q1_2]),
                          fma(FLOAT_TYPE(b1.w), FLOAT_TYPE(kvalues_iq5_k[table1 + q1_3]),
                          sum1[j]))));
            }
        }

        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            temp[j][n] = fma(dscale0, sum0[j], fma(dscale1, sum1[j], temp[j][n]));
        }

        ibi += num_blocks_per_row;
    }
}

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    uint a_offset, b_offset, d_offset;

    get_offsets(a_offset, b_offset, d_offset);

    const uint num_blocks_per_row = p.ncols / QUANT_K;

    const uint blocks_per_wg = gl_WorkGroupSize.x/8;
    const uint tid = gl_LocalInvocationID.x;
    const uint itid = tid % 8;
    const uint ix = tid / 8;

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint i = 0; i < NUM_ROWS; ++i) {
            temp[j][i] = FLOAT_TYPE(0);
        }
    }

    [[unroll]] for (uint i = ix; i < num_blocks_per_row; i += blocks_per_wg)
        calc_superblock(a_offset, b_offset, itid, i, num_blocks_per_row, first_row, num_rows);

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
