#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage : require

#include "mul_mat_vec_base.glsl"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

const int kvalues_iq3_k[16] = int[16](
    -63, -40, -23, -10, 1, 13, 28, 47,
    -59, -36, -19, -6, 5, 17, 32, 51
);

void calc_superblock(const uint a_offset, const uint b_offset, const uint ib32, const uint i, const uint num_blocks_per_row, const uint first_row, const uint num_rows) {
    const uint y_idx = i * QUANT_K + 32 * ib32;

    uint ibi = a_offset + first_row * num_blocks_per_row + i;
    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
        const float d = float(data_a[ibi].d);
        const int scale0 = (2 * int(uint(data_a[ibi].scales_l[ib32]) & 0xf) + 1) * ((((uint(data_a[ibi].scales_h) >> (2 * ib32)) & 1) != 0) ? -1 : 1);
        const int scale1 = (2 * int(uint(data_a[ibi].scales_l[ib32]) >> 4) + 1) * ((((uint(data_a[ibi].scales_h) >> (2 * ib32 + 1)) & 1) != 0) ? -1 : 1);
        const float dscale0 = d * float(scale0);
        const float dscale1 = d * float(scale1);
        const uint table0 = (((uint(data_a[ibi].extra) >> (2 * ib32)) & 1) != 0) ? 8 : 0;
        const uint table1 = (((uint(data_a[ibi].extra) >> (2 * ib32 + 1)) & 1) != 0) ? 8 : 0;
        const uint qs_base = ib32 < 4 ? 0 : 32;
        const uint shift = 2 * (ib32 % 4);

        FLOAT_TYPE sum0[NUM_COLS];
        FLOAT_TYPE sum1[NUM_COLS];
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            sum0[j] = FLOAT_TYPE(0);
            sum1[j] = FLOAT_TYPE(0);
        }

        [[unroll]] for (uint l = 0; l < 4; ++l) {
            const uint idx = 4 * l;
            const uint q0_0 = ((uint(data_a[ibi].qs[qs_base + idx + 0]) >> shift) & 3) | (((uint(data_a[ibi].qh[idx + 0]) >> ib32) & 1) << 2);
            const uint q0_1 = ((uint(data_a[ibi].qs[qs_base + idx + 1]) >> shift) & 3) | (((uint(data_a[ibi].qh[idx + 1]) >> ib32) & 1) << 2);
            const uint q0_2 = ((uint(data_a[ibi].qs[qs_base + idx + 2]) >> shift) & 3) | (((uint(data_a[ibi].qh[idx + 2]) >> ib32) & 1) << 2);
            const uint q0_3 = ((uint(data_a[ibi].qs[qs_base + idx + 3]) >> shift) & 3) | (((uint(data_a[ibi].qh[idx + 3]) >> ib32) & 1) << 2);

            const uint q1_0 = ((uint(data_a[ibi].qs[qs_base + 16 + idx + 0]) >> shift) & 3) | (((uint(data_a[ibi].qh[16 + idx + 0]) >> ib32) & 1) << 2);
            const uint q1_1 = ((uint(data_a[ibi].qs[qs_base + 16 + idx + 1]) >> shift) & 3) | (((uint(data_a[ibi].qh[16 + idx + 1]) >> ib32) & 1) << 2);
            const uint q1_2 = ((uint(data_a[ibi].qs[qs_base + 16 + idx + 2]) >> shift) & 3) | (((uint(data_a[ibi].qh[16 + idx + 2]) >> ib32) & 1) << 2);
            const uint q1_3 = ((uint(data_a[ibi].qs[qs_base + 16 + idx + 3]) >> shift) & 3) | (((uint(data_a[ibi].qh[16 + idx + 3]) >> ib32) & 1) << 2);

            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                const vec4 b0 = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + y_idx) / 4 + l]);
                const vec4 b1 = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + y_idx) / 4 + 4 + l]);

                sum0[j] = fma(FLOAT_TYPE(b0.x), FLOAT_TYPE(kvalues_iq3_k[table0 + q0_0]),
                          fma(FLOAT_TYPE(b0.y), FLOAT_TYPE(kvalues_iq3_k[table0 + q0_1]),
                          fma(FLOAT_TYPE(b0.z), FLOAT_TYPE(kvalues_iq3_k[table0 + q0_2]),
                          fma(FLOAT_TYPE(b0.w), FLOAT_TYPE(kvalues_iq3_k[table0 + q0_3]),
                          sum0[j]))));
                sum1[j] = fma(FLOAT_TYPE(b1.x), FLOAT_TYPE(kvalues_iq3_k[table1 + q1_0]),
                          fma(FLOAT_TYPE(b1.y), FLOAT_TYPE(kvalues_iq3_k[table1 + q1_1]),
                          fma(FLOAT_TYPE(b1.z), FLOAT_TYPE(kvalues_iq3_k[table1 + q1_2]),
                          fma(FLOAT_TYPE(b1.w), FLOAT_TYPE(kvalues_iq3_k[table1 + q1_3]),
                          sum1[j]))));
            }
        }

        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            temp[j][n] = fma(dscale0, sum0[j], fma(dscale1, sum1[j], temp[j][n]));
        }

        ibi += num_blocks_per_row;
    }
}

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    uint a_offset, b_offset, d_offset;

    get_offsets(a_offset, b_offset, d_offset);

    const uint num_blocks_per_row = p.ncols / QUANT_K;

    const uint blocks_per_wg = gl_WorkGroupSize.x/8;
    const uint tid = gl_LocalInvocationID.x;
    const uint itid = tid % 8;
    const uint ix = tid / 8;

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint i = 0; i < NUM_ROWS; ++i) {
            temp[j][i] = FLOAT_TYPE(0);
        }
    }

    [[unroll]] for (uint i = ix; i < num_blocks_per_row; i += blocks_per_wg)
        calc_superblock(a_offset, b_offset, itid, i, num_blocks_per_row, first_row, num_rows);

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
