#version 450

#extension GL_EXT_shader_8bit_storage : require

#include "types.glsl"
#include "generic_binary_head.glsl"

layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;

const uint pow3[5] = uint[5](1u, 3u, 9u, 27u, 81u);

void main() {
    const uint col = gl_GlobalInvocationID.x;
    if (col >= p.ne00) {
        return;
    }

    const uint ib = col / 128u;
    const uint e = col % 128u;
    uint byte_off;
    uint n;
    if (e < 80u) {
        n = e >> 4u;
        byte_off = e & 15u;
    } else if (e < 120u) {
        const uint u = e - 80u;
        n = u >> 3u;
        byte_off = 16u + (u & 7u);
    } else {
        const uint u = e - 120u;
        n = u >> 1u;
        byte_off = 24u + (u & 1u);
    }
    const uint p3 = pow3[n];

    for (uint z = gl_GlobalInvocationID.z; z < p.ne11 * p.ne12; z += gl_NumWorkGroups.z) {
        for (uint y = gl_GlobalInvocationID.y; y < p.ne10; y += gl_NumWorkGroups.y) {
            const uint i11 = z / p.ne12;
            const uint i12 = z % p.ne12;
            const uint row = uint(data_b[get_boffset() + y * p.nb10 + i11 * p.nb11 + i12 * p.nb12]);
            const uint block_offset = get_aoffset() + row * p.nb01 + i11 * p.nb02 + i12 * p.nb03 + ib * 28u;
            const float d = unpackHalf2x16(uint(data_a[block_offset + 26u]) | (uint(data_a[block_offset + 27u]) << 8u)).x;
            const uint b = uint(data_a[block_offset + byte_off]);
            const uint q = (b * p3) & 0xFFu;
            const int xi = int((q * 3u) >> 8u);
            const float val = float(xi - 1) * d;

            const uint dst = get_doffset() + y * p.nb21 + i11 * p.nb22 + i12 * p.nb23 + col;
            data_d[dst] = D_TYPE(val);
        }
    }
}
