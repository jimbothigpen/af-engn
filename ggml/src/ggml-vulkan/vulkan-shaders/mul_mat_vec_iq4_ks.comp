#version 450

#include "mul_mat_vec_base.glsl"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];
const int kvalues_iq4_ks[32] = int[32](-127, -104, -83, -65, -49, -35, -22, -10, 1, 13, 25, 38, 53, 69, 89, 113, -123, -100, -79, -61, -45, -31, -18, -6, 5, 17, 29, 42, 57, 73, 93, 117);

uint read_u32(uint offset) {
return uint(data_a[offset]) | (uint(data_a[offset + 1]) << 8) | (uint(data_a[offset + 2]) << 16) | (uint(data_a[offset + 3]) << 24);
}

void compute_outputs(uint first_row, uint num_rows) {
uint a_offset, b_offset, d_offset;
get_offsets(a_offset, b_offset, d_offset);
const uint nb = p.ncols / 256;
const uint row_bytes = 4 + nb * 136;
const uint tid = gl_LocalInvocationID.x;
const uint g = tid % 8;
for (uint j = 0; j < NUM_COLS; ++j) {
for (uint n = 0; n < NUM_ROWS; ++n) {
temp[j][n] = FLOAT_TYPE(0);
}
}
for (uint i = tid / 8; i < nb; i += gl_WorkGroupSize.x / 8) {
for (uint n = 0; n < num_rows; ++n) {
const uint row_offset = (a_offset / nb + first_row + n) * row_bytes;
const uint block_offset = row_offset + 4 + i * 136;
const uint scale = uint(data_a[block_offset + g]);
const uint lut_offset = (scale & 1) << 4;
const FLOAT_TYPE d = FLOAT_TYPE(uintBitsToFloat(read_u32(row_offset)) * float(int(scale & 254) - 127));
for (uint j = 0; j < NUM_COLS; ++j) {
FLOAT_TYPE sum = FLOAT_TYPE(0);
for (uint lane = 0; lane < 32; ++lane) {
const uint q = uint(data_a[block_offset + 8 + g * 16 + lane % 16]);
const uint nibble = (q >> ((lane >= 16) ? 4 : 0)) & 15;
const uint b_index = j * p.batch_stride_b + b_offset + i * 256 + g * 32 + lane;
sum = fma(FLOAT_TYPE(data_b[b_index]), FLOAT_TYPE(kvalues_iq4_ks[lut_offset + nibble]), sum);
}
temp[j][n] = fma(d, sum, temp[j][n]);
}
}
}
reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);
if (first_row >= p.stride_d) {
return;
}
compute_outputs(first_row, min(NUM_ROWS, p.stride_d - first_row));
}
