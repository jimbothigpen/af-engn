#version 450

#extension GL_EXT_shader_8bit_storage : require

#include "dequant_head.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly buffer A { uint8_t data_a_bytes[]; };
layout(binding = 1) writeonly buffer D { D_TYPE data_b[]; };

const int kvalues_iq2_ks[8] = int[8](-31, -13, 1, 17, -26, -8, 6, 22);

uint read_u16(uint offset) {
    return uint(data_a_bytes[offset]) | (uint(data_a_bytes[offset + 1]) << 8);
}

void main() {
    const uint ib = gl_WorkGroupID.x * 32 + gl_LocalInvocationID.x / 8;
    if (ib >= p.nel / 256) {
        return;
    }
    const uint nb = p.K / 256;
    const uint row_offset = (ib / nb) * (2 + nb * 70);
    const uint block_offset = row_offset + 2 + (ib % nb) * 70;
    const uint group = gl_LocalInvocationID.x % 8;
    const uint ib64 = group / 2;
    const uint half_group = group % 2;
    const uint extra = read_u16(block_offset) >> (2 * ib64);
    const uint scales = uint(data_a_bytes[block_offset + 2 + ib64]);
    const uint scale = ((scales >> (4 * half_group)) & 15) | ((extra >> (4 + half_group)) & 16);
    const uint table = ((extra >> half_group) & 1) * 4;
    const float d = unpackHalf2x16(read_u16(row_offset)).x * float(int(scale) - 16);
    const uint qs_offset = block_offset + 6 + (ib64 / 2) * 32;
    const uint shift = 4 * (ib64 % 2) + 2 * half_group;
    for (uint lane = 0; lane < 32; ++lane) {
        const uint code = (uint(data_a_bytes[qs_offset + lane]) >> shift) & 3;
        data_b[256 * ib + 32 * group + lane] = D_TYPE(d * float(kvalues_iq2_ks[table + code]));
    }
}
