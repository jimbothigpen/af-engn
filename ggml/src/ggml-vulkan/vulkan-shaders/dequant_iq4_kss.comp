#version 450

#extension GL_EXT_shader_8bit_storage : require

#include "dequant_head.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly buffer A { uint8_t data_a_bytes[]; };
layout(binding = 1) writeonly buffer D { D_TYPE data_b[]; };

const int kvalues_iq4_ks[32] = int[32](-127, -104, -83, -65, -49, -35, -22, -10, 1, 13, 25, 38, 53, 69, 89, 113, -123, -100, -79, -61, -45, -31, -18, -6, 5, 17, 29, 42, 57, 73, 93, 117);

uint read_u16(uint offset) {
return uint(data_a_bytes[offset]) | (uint(data_a_bytes[offset + 1]) << 8);
}

uint read_u32(uint offset) {
return uint(data_a_bytes[offset]) | (uint(data_a_bytes[offset + 1]) << 8) | (uint(data_a_bytes[offset + 2]) << 16) | (uint(data_a_bytes[offset + 3]) << 24);
}

void main() {
const uint ib = gl_WorkGroupID.x * 32 + gl_LocalInvocationID.x / 8;
if (ib >= p.nel / 256) {
return;
}
const uint nb = p.K / 256;
const uint row_offset = (ib / nb) * (4 + nb * 128);
const uint block_offset = row_offset + 4 + (ib % nb) * 128;
const uint g = gl_LocalInvocationID.x % 8;
const uint subgroup_offset = block_offset + 16 * g;
uint ls = 0;
for (uint lane = 0; lane < 8; ++lane) {
ls |= (read_u16(subgroup_offset + 2 * lane) & 1) << lane;
}
const float d = uintBitsToFloat(read_u32(row_offset));
const float dl = d * float(int(ls & 254) - 127);
const uint page = (ls & 1) << 4;
for (uint j = 0; j < 16; ++j) {
const uint lane = j / 2;
const uint u = read_u16(subgroup_offset + 2 * lane);
const uint aux = (u & 65534) ^ ((u & 65534) >> 1);
const uint qbyte = (aux >> (8 * (j % 2))) & 255;
data_b[256 * ib + 32 * g + j] = D_TYPE(dl * float(kvalues_iq4_ks[page + (qbyte & 15)]));
data_b[256 * ib + 32 * g + 16 + j] = D_TYPE(dl * float(kvalues_iq4_ks[page + (qbyte >> 4)]));
}
}
