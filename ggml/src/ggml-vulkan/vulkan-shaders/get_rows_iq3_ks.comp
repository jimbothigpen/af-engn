#version 450

#extension GL_EXT_shader_8bit_storage : require

#include "types.glsl"
#include "generic_binary_head.glsl"

layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;
const int kvalues_iq3_ks[16] = int[16](-63, -40, -23, -10, 1, 13, 28, 47, -59, -36, -19, -6, 5, 17, 32, 51);

uint read_u16(uint offset) {
return uint(data_a[offset]) | (uint(data_a[offset + 1]) << 8);
}

void main() {
const uint col = gl_GlobalInvocationID.x;
if (col >= p.ne00) {
return;
}
for (uint z = gl_GlobalInvocationID.z; z < p.ne11 * p.ne12; z += gl_NumWorkGroups.z) {
for (uint y = gl_GlobalInvocationID.y; y < p.ne10; y += gl_NumWorkGroups.y) {
const uint i11 = z / p.ne12;
const uint i12 = z % p.ne12;
const uint row = uint(data_b[get_boffset() + y * p.nb10 + i11 * p.nb11 + i12 * p.nb12]);
const uint row_offset = get_aoffset() + row * p.nb01 + i11 * p.nb02 + i12 * p.nb03;
const uint block_offset = row_offset + 2 + (col / 256) * 102;
const uint t = (col % 256) / 32;
const uint j = col % 32;
const uint extra = read_u16(block_offset);
const uint scales = uint(data_a[block_offset + 2 + t % 4]);
const int scale = int(((scales >> (4 * (t / 4))) & 15) | (((extra >> t) & 1) << 4)) - 16;
const uint table = ((extra >> (8 + t)) & 1) * 8;
const uint qs = uint(data_a[block_offset + 6 + 32 * (t / 4) + j]);
const uint qh = uint(data_a[block_offset + 70 + j]);
const uint code = ((qs >> (2 * (t % 4))) & 3) | (((qh >> t) & 1) << 2);
const uint dst = get_doffset() + y * p.nb21 + i11 * p.nb22 + i12 * p.nb23 + col;
data_d[dst] = D_TYPE(unpackHalf2x16(read_u16(row_offset)).x * float(scale * kvalues_iq3_ks[table + code]));
}
}
}
